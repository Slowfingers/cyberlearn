{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm run build:functions"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "*.test.mjs",
      "test-*.mjs",
      "migrate.mjs",
      "resetTeacherPassword.mjs"
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
